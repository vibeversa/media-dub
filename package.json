{
  "name": "media-dub",
  "private": true,
  "version": "0.1.0",
  "description": "Repository tooling root. The application frontend lives in frontend/; this manifest exists so the cross-layer Playwright rig can be driven from the repository root.",
  "type": "module",
  "scripts": {
    "test:cross-layer": "playwright test --grep=@cross-layer",
    "test:cross-layer:ui": "playwright test --ui",
    "test:a11y": "playwright test --grep=@a11y",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.json",
    "test:visual": "playwright test --grep=@visual",
    "test:visual:update": "playwright test --grep=@visual --update-snapshots",
    "test:perf": "playwright test --grep=@perf",
    "test:tools": "node --test tools/*.test.mjs deploy/frontend/*.test.mjs",
    "check:runbooks": "node --test tools/runbooks-index.test.mjs tools/product-runbooks.test.mjs",
    "check:backup": "node --test tools/backup-coverage.test.mjs",
    "check:backup-policy": "node scripts/check-backup-policy.mjs",
    "test:backup-policy": "node --test tools/backup-policy.test.mjs",
    "check:i18n": "node scripts/check-no-hardcoded-copy.mjs",
    "drill:restore": "bash scripts/restore-drill.sh",
    "check:unit-containers": "node tools/unit-tier-containers.mjs",
    "check:rollout": "node scripts/check-rollout-window.mjs",
    "check:hosting": "bash deploy/tests/hosting.test.sh",
    "check:frontend": "node --test deploy/frontend/*.test.mjs",
    "check:frontend-topology": "node scripts/check-frontend-topology.mjs",
    "check:vite-env": "bash scripts/vite-env-audit.sh --allowlist-sync",
    "inject:config": "bash deploy/config-inject.sh",
    "check:api-contract": "node tools/check-api-contract.mjs",
    "check:openapi-diff": "bash scripts/openapi-diff.sh --base main --head HEAD",
    "check:openapi-diff:self-test": "bash scripts/openapi-diff.sh --self-test",
    "check:contract-canary": "bash scripts/contract-canary.sh",
    "lint:workflows": "bash scripts/workflow-lint.sh",
    "verify:deploy": "bash deploy/verify.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "axe-core": "4.13.0",
    "typescript": "5.6.3"
  }
}
