<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Task 043: the build stamp `GET /version` reports.
       Every value is stamped by the same compile that produced the code, so
       "which build is answering?" cannot drift from the artefact. All four are
       optional and default to the literal `CHANGE_ME`, which BuildInformation
       normalises to `unknown` - a visible sentinel rather than a plausible wrong
       value. CI passes them explicitly:

         dotnet publish -p:BuildCommit=$GITHUB_SHA \
                        -p:BuildRelease=$GITHUB_REF_NAME \
                        -p:BuildOpenApiVersion=<openapi info.version> \
                        -p:BuildTimestampUtc=<ISO-8601>

       The OpenAPI version is deliberately a build ARGUMENT rather than something
       read at runtime. The document the server emits is generated from
       OpenApiConfiguration; reading the committed bundle at runtime would let the
       server report a version its own document does not carry, which is the one
       disagreement `/version` exists to make impossible. -->
  <PropertyGroup>
    <BuildCommit Condition="'$(BuildCommit)' == ''">CHANGE_ME</BuildCommit>
    <BuildRelease Condition="'$(BuildRelease)' == ''">CHANGE_ME</BuildRelease>
    <BuildOpenApiVersion Condition="'$(BuildOpenApiVersion)' == ''">CHANGE_ME</BuildOpenApiVersion>
    <BuildTimestampUtc Condition="'$(BuildTimestampUtc)' == ''">CHANGE_ME</BuildTimestampUtc>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildCommit" Value="$(BuildCommit)" />
    <AssemblyMetadata Include="BuildRelease" Value="$(BuildRelease)" />
    <AssemblyMetadata Include="BuildOpenApiVersion" Value="$(BuildOpenApiVersion)" />
    <AssemblyMetadata Include="BuildTimestampUtc" Value="$(BuildTimestampUtc)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.18.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.18.0-rc.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DubbingPlatform.Application\DubbingPlatform.Application.csproj" />
    <ProjectReference Include="..\DubbingPlatform.Infrastructure\DubbingPlatform.Infrastructure.csproj" />
    <ProjectReference Include="..\DubbingPlatform.Contracts\DubbingPlatform.Contracts.csproj" />
  </ItemGroup>

  <!-- Task 014 drift gate: in CI, dotnet build regenerates the TypeScript
       client to a temp dir and diffs it against frontend/src/api/generated/.
       CI-only so backend container builds and node-less machines keep working;
       the dedicated api-contract CI job also runs make check-api-drift plus
       the frontend build. Skip locally with -p:SkipApiDriftCheck=true. -->
  <Target Name="CheckApiClientDrift" AfterTargets="Build" Condition="'$(CI)' == 'true' And '$(SkipApiDriftCheck)' != 'true' And '$(DesignTimeBuild)' != 'true'">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../tools/check-api-drift.mjs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>

</Project>
