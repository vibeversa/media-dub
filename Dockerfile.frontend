# syntax=docker/dockerfile:1.7
# Frontend image (Task 042; layout and build-path fixes in Task 043).
#
# This is a STATIC SPA behind nginx. Two decisions in it are load-bearing and
# both are the kind that produce a bug that only appears in production:
#
#   1. The SPA fallback. Every unknown path must serve index.html, because a deep
#      link like /projects/01H.../workspace is handled by the client router and the
#      server has never heard of it. Without `try_files ... /index.html` that URL
#      is a 404 a user sees, and no amount of client-side routing fixes it.
#   2. The cache policy. `/assets/*` filenames carry a content hash, so they are
#      immutable and can be cached for a year. `index.html` MUST NOT be, or a
#      deploy ships new hashed assets while browsers keep serving the old
#      document that references the previous hashes - a white screen after every
#      release, and the single most common way a hashed-asset setup fails.
#
# A third one was added in Task 043: a MISSING hashed asset is a 404, never the
# document. See `deploy/nginx/default.conf`; the short version is that serving
# index.html for a missing chunk gives the browser 200 text/html where it
# expected JavaScript, and the resulting SyntaxError names the frontend rather
# than the CDN, which is where the investigation then goes.
#
# Task 043A added two more things, and both are visible in the file:
#   * a precompression pass in the `dist` stage, because the origin's
#     `gzip_static on;` needs `.gz` siblings to exist and this image has NO
#     brotli module - brotli is served from the CDN edge instead;
#   * the HEALTHCHECK moved from `/` to `/healthz`, a static 200 served from the
#     nginx config with no dependency on the build output. Asking for the document
#     conflated "the process can serve" with "the build produced an index.html",
#     which is a distinction worth having on the morning somebody changes the
#     build.
#
# The VITE_* variables are inlined at BUILD time by Vite, so this image is
# specific to the API it was built against. That is why the image is versioned
# and signed like the backend ones (R5): an `index.html` baked with the wrong API
# base URL is a different product, not a different build of the same one.

# --- build --------------------------------------------------------------------
FROM node:24-alpine AS build
WORKDIR /src/frontend

# THE LAYOUT HERE IS THE REPOSITORY LAYOUT, AND IT HAS TO BE
# -----------------------------------------------------------
# `npm run build` runs a `prebuild` -> `check-drift` -> `node ../tools/
# check-api-drift.mjs`. That script resolves the repository root as
# `dirname(script)/..` and then looks for `frontend/src/api/generated/` and
# `src/DubbingPlatform.Api/OpenApi/openapi.v1.json` beneath it. It is a
# repository-relative tool, not a frontend-local one.
#
# So the build stage works from `/src/frontend` and the other two paths are copied
# to `/src/tools` and `/src/src/...` - the SAME shape the repository has.
# Flattening to `/app` and copying `tools/` to `/tools` looks equivalent and is
# not: the script then resolves the root as `/` and looks for
# `/frontend/src/api/generated` while the app is at `/app/src/api/generated`. It
# reports "committed output missing" for a directory that is demonstrably
# present, which is a very confusing way to say "your path layout is wrong".
#
# The previous version of this file had `WORKDIR /app` and copied only
# `frontend/`, so the build failed with MODULE_NOT_FOUND. Nothing noticed: 042's
# `deploy/verify.sh` asserted the Dockerfile and the nginx config EXISTED and
# that the config said the right things, and no pipeline ever ran
# `docker build` - the gap the 042 report recorded as "the first CI run is the
# first build". `deploy/tests/hosting.test.sh` now runs it, which is how both of
# these were found.
#
# The drift gate is not optional here. A bundle that has drifted from the
# generated client produces a frontend that calls endpoints the API does not
# serve, and that failure is a runtime 404 in a user's browser rather than a
# build error.

# The lockfile is copied on its own so a source-only change reuses the cached
# install layer. `npm ci` - never `npm install` - so the image is built from
# exactly the tree the lockfile pins, which is also the tree the audit gate read.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
COPY tools/ /src/tools/
COPY src/DubbingPlatform.Api/OpenApi/ /src/src/DubbingPlatform.Api/OpenApi/

# `.env.production` is written by `deploy/config-inject.sh` per environment and
# takes precedence over `.env` in Vite's mode resolution. It is copied rather
# than generated here so the image that ships is the image that was audited: the
# values in the bundle are exactly the ones `scripts/vite-env-audit.sh` cleared.
# The fallback keeps `docker build` working on a bare checkout, and the resulting
# bundle points at the documented local API.
#
# The `echo`+`ls` is there so the build log records WHICH env file was used. A
# build that silently fell back to the example file produces a bundle pointing at
# localhost, and this line is the only place that shows it happened.
RUN { [ -f .env.production ] || cp .env.example .env; } \
 && echo "frontend env file in use:" \
 && (ls -1 .env.production 2>/dev/null || echo "  .env (fallback: .env.example)")
RUN npm run build

# --- the version document, placed AFTER the build (Task 043A) ----------------
# `deploy/config-inject.sh` stages the document at `frontend/version.json` - a
# SIBLING of `.env.production`, not a bundler output - and this copies it into the
# build output afterwards.
#
# The ordering is the whole point. `vite build` empties `outDir` by default, so the
# document used to be written straight into `dist/` by config-inject.sh and then
# DELETED by the build: every release image shipped without one, and the hosting
# gate reported the resulting 404 as "as expected for an image built without
# config-inject.sh" - indistinguishable from the local case, because it was the
# release case. A version-skew check that can never see the document is a check
# that reports nothing and looks healthy.
#
# The `if` is deliberate and its failure mode is the point: a build that did not
# run the injector produces an image with no document, which the gate reports as a
# 404 and the client reports as UNKNOWN (no banner). A build that DID run it always
# gets one. Silently substituting a placeholder would be worse: a placeholder
# reports a version, and a version that is wrong is a skew check that agrees with
# itself.
RUN if [ -f version.json ]; then \
      cp version.json dist/version.json && \
      echo "version document in use: frontend/version.json -> dist/version.json"; \
    else \
      echo "  no version document: this image was built without deploy/config-inject.sh,"; \
      echo "  so /version.json is a 404 and the client's skew check reports UNKNOWN."; \
    fi

# --- precompress (Task 043A) -------------------------------------------------
# Writes a `.gz` and a `.br` sibling next to every asset over 4 KiB, so the origin
# serves a file that already exists instead of compressing the same bytes once per
# request, and so a CDN configured for Brotli has something to serve.
#
# `node:zlib` only - no `gzip`/`brotli` binary to install, no extra layer, and no
# dependency whose CVE would appear in this image's scan. Both algorithms are in
# the node that is already here to run the build.
#
# ONLY assets. A `.gz` of index.html would sit next to it at the top level, where
# `location /` (not `location ^~ /assets/`) matches it - and `location /` declares
# no Cache-Control, so the precompressed document would be served with none at all.
# The document is under 2 KiB and is never cached anyway, so there is nothing to
# win there.
#
# `.map` is absent from the set deliberately. `vite build` sets `sourcemap: false`
# and `deploy/nginx/default.conf` refuses `.map` with a 404; a `.map.gz` next to a
# map nobody builds would be a second thing to remember to exclude.
#
# A HEREDOC, not a `\` continuation. The first version indented the script
# directly under `RUN node -e '`, and the build failed at PARSE time with
# `dockerfile parse error on line 115: unknown instruction: import` - a
# Dockerfile continuation is a trailing backslash, and a multi-line quoted string
# is not one. The script was never run; the image was never produced. `<<'EOF'`
# (available from `# syntax=docker/dockerfile:1.4`, and this file declares 1.7)
# passes the block to the shell verbatim, so the quoting below is the shell's
# problem and not the parser's.
RUN <<'PRECOMPRESS'
node --input-type=module -e '
  import { readdirSync, readFileSync, writeFileSync } from "node:fs";
  import { extname, join } from "node:path";
  import { brotliCompressSync, constants, gzipSync } from "node:zlib";

  const COMPRESSIBLE = new Set([".js", ".css", ".svg", ".woff", ".woff2"]);
  const MIN_BYTES = 4096;
  let written = 0;
  const walk = (dir) => {
    for (const entry of readdirSync(dir, { withFileTypes: true })) {
      const full = join(dir, entry.name);
      if (entry.isDirectory()) {
        walk(full);
        continue;
      }
      if (!COMPRESSIBLE.has(extname(entry.name))) continue;
      const bytes = readFileSync(full);
      if (bytes.length < MIN_BYTES) continue;
      writeFileSync(full + ".gz", gzipSync(bytes, { level: constants.Z_BEST_COMPRESSION }));
      writeFileSync(
        full + ".br",
        brotliCompressSync(bytes, {
          params: {
            [constants.BROTLI_PARAM_QUALITY]: 11,
            [constants.BROTLI_PARAM_SIZE_HINT]: bytes.length,
          },
        }),
      );
      written += 1;
    }
  };
  walk(join(process.cwd(), "dist"));
  console.log("precompressed " + written + " asset(s) to .gz and .br");
'
PRECOMPRESS

# The build output is copied into its own stage so the runtime image carries no
# node_modules, no package.json, and no source. A static file server has no
# business carrying a package tree, and `npm audit` findings in a dev dependency
# are one less thing to reason about in a deployed artefact.
FROM scratch AS dist
COPY --from=build /src/frontend/dist /

# --- runtime ------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# Port 8080, not 80: the unprivileged image cannot bind a port below 1024, and
# binding 80 anyway would be the kind of privilege the rest of this image is
# built to avoid. The origin Service targets 8080
# (deploy/k8s/frontend/service.yaml).
EXPOSE 8080

COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
# The security headers are a separate include because nginx's `add_header`
# REPLACES the inherited set in any block that declares one of its own, so every
# such block has to re-declare them. One copy, included everywhere, is the only
# way that does not drift. See deploy/nginx/security-headers.conf.
COPY deploy/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=dist / /usr/share/nginx/html

# nginx-unprivileged runs as uid 101 with a writable /tmp and a pid file under
# /tmp; nothing here needs root, and the image says so.
USER nginx

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/bin/sh", "-c", "wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1"]

# `CMD` not `ENTRYPOINT`: an operator overriding the command should not have to
# fight an entrypoint script to do it.
CMD ["nginx", "-g", "daemon off;"]
