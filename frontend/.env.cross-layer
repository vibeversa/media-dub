# Task 040A: cross-layer frontend build profile.
#
# Vite inlines VITE_* at build time, so a cross-layer bundle cannot share the
# default frontend/.env (which points at the dev API on :5000). The rig builds
# with `--mode cross-layer`, which loads this file instead. The API port must
# match the `api` service mapping in tests/cross-layer/docker-compose.cross.yml.
#
# 127.0.0.1, not localhost. Docker Desktop's published ports accept an IPv6 TCP
# handshake and then reset it, and both Chromium and Node resolve `localhost` to
# ::1 first, so the localhost form fails against a healthy stack. The frontend
# origin, this API base URL and the api service's CORS allow-list must all use
# the same spelling; the CSP in frontend/index.html allows loopback either way.
#
# Nothing secret belongs here: this file is inlined verbatim into the public
# browser bundle. Backend credentials and signing keys stay in the compose `api`
# service environment, never in a VITE_* variable.
#
# VITE_CDN_ORIGIN and VITE_VERSION_TAG (Task 043) are omitted rather than set
# empty: `getDeployConfig()` resolves an unset CDN origin to the API origin, which
# is the correct value for a single-origin loopback build, and an unset version tag
# to `VITE_APP_VERSION`. Writing `VITE_CDN_ORIGIN=` here would be an EMPTY_VALUE
# rejection in `scripts/vite-env-audit.sh` - correctly, since an empty injected
# value passes an "is it configured" check and then requests no origin.
VITE_API_BASE_URL=http://127.0.0.1:58080
VITE_APP_VERSION=0.1.0-cross-layer
VITE_SSE_ENABLED=true
VITE_TELEMETRY_ENABLED=false
