{
  "name": "dubbing-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Dubbing platform frontend (Task 015+ scaffolding lands here; Task 014 owns src/api/generated).",
  "type": "module",
  "scripts": {
    "generate-api": "node ../tools/generate-client.mjs",
    "check-drift": "node ../tools/check-api-drift.mjs",
    "prebuild": "npm run check-drift",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "dev": "vite",
    "preview": "vite preview",
    "check:no-hex": "node ../tools/check-no-hex.mjs",
    "build-storybook": "storybook build -o storybook-static"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.63.0",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "openapi-typescript-codegen": "0.31.0",
    "postcss": "^8.4.49",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.15",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.11",
    "i18next": "^26.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  }
}
